{
  "name": "plato",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fixtures": "PLATO_CONTENT_DIR=e2e/fixtures/content next dev",
    "build": "next build && tsx scripts/prepare-standalone.ts",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "course:validate": "tsx scripts/course-validate.ts",
    "course:publish": "tsx scripts/course-publish.ts",
    "course:not-built": "tsx scripts/course-not-built.ts",
    "content:check": "tsx scripts/content-check.ts",
    "requests:export": "tsx scripts/requests-export.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "better-sqlite3": "^13.2.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "katex": "^0.19.1",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "hast-util-to-html": "^9.0.7",
    "mdast-util-directive": "^3.2.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
