exports[`directive snapshots > :::analogy 1`] = `"<aside id="padlock" aria-label="Analogy" class="my-4 scroll-mt-20 rounded-lg border border-dashed p-4 [&amp;&gt;p:first-child]:mt-0 [&amp;&gt;p:last-child]:mb-0"><div class="mb-1 text-xs font-medium text-muted-foreground">Analogy</div><p class="my-3">Think of a <em>padlocked</em> box.</p><p class="my-3">Anyone sees only the lock.</p></aside>"`;

