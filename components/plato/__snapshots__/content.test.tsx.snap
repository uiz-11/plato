exports[`directive snapshots > ::figure 1`] = `"<figure class="my-6"><div class="mx-auto max-w-xl text-foreground [&amp;&gt;svg]:h-auto [&amp;&gt;svg]:w-full"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10" role="img" aria-label="A filled square." focusable="false"><rect width="10" height="10" fill="currentColor"></rect></svg></div><figcaption class="mt-2 text-center text-xs text-muted-foreground">One square.</figcaption></figure>"`;

